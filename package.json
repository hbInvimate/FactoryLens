{
  "name": "factorylens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test",
    "db:seed-sample": "node --env-file-if-exists=.env.local --import tsx scripts/seed-sample.mts",
    "db:clear-sample": "node --env-file-if-exists=.env.local --import tsx scripts/clear-sample.mts",
    "db:backfill": "node --env-file-if-exists=.env.local --import tsx scripts/backfill.mts",
    "user:create": "node --env-file-if-exists=.env.local --import tsx scripts/user.mts create",
    "user:reset-password": "node --env-file-if-exists=.env.local --import tsx scripts/user.mts reset-password",
    "user:disable": "node --env-file-if-exists=.env.local --import tsx scripts/user.mts disable",
    "task:create": "node --env-file-if-exists=.env.local --import tsx scripts/task.mts create"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.9",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
