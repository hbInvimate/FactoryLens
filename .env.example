# Copy to .env.local (never commit it), or run `vercel env pull .env.local`.
# Postgres connection string from the Neon integration in the Vercel Marketplace.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Signs the sign-in cookie. At least 32 characters, a different value per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: the site's address, e.g. https://your-app.vercel.app. On Vercel the deployment address is used.
# BETTER_AUTH_URL=

# Optional, for tests and demos only: a temporary in-process database with test accounts, never Neon.
# FL_STORAGE=memory
